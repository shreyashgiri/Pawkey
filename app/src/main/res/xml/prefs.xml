<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <PreferenceCategory app:title="Get started" app:key="setup" app:iconSpaceReserved="false">
        <Preference app:key="setup_enable" app:title="1. Turn on PawKeys" app:iconSpaceReserved="false" />
        <Preference app:key="setup_select" app:title="2. Switch to PawKeys" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Look and feel" app:iconSpaceReserved="false">
        <ListPreference app:key="theme" app:title="Theme" app:defaultValue="system"
            app:entries="@array/theme_names" app:entryValues="@array/theme_values"
            app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="key_borders" app:title="Key borders" app:defaultValue="false" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="number_row" app:title="Number row" app:defaultValue="false" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="hint_chars" app:title="Show alternative characters"
            app:summary="Numbers and symbols in the corner of the letter keys. Long-press a key to type them."
            app:defaultValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference app:key="keyboard_height" app:title="Keyboard size (%)" app:defaultValue="100"
            app:min="70" android:max="140" app:showSeekBarValue="true" app:seekBarIncrement="5"
            app:iconSpaceReserved="false"/>
        <ListPreference app:key="one_handed" app:title="One-handed mode" app:defaultValue="off"
            app:entries="@array/one_handed_names" app:entryValues="@array/one_handed_values"
            app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Smart typing" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="suggestions" app:title="Predictive text" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="autocorrect" app:title="Auto replace"
            app:summary="Fix typos when you press space. Press backspace to undo." app:defaultValue="true"
            app:dependency="suggestions" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="next_word" app:title="Next-word suggestions"
            app:summary="Learned from what you type, stays on your phone" app:defaultValue="true"
            app:dependency="suggestions" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="learn_words" app:title="Learn new words" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="block_offensive" app:title="Block offensive words" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="auto_cap" app:title="Auto capitalise" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="double_space_period" app:title="Double-space for full stop" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="smart_punctuation" app:title="Smart punctuation"
            app:summary="Typing . , ! ? after a suggested word or swipe-space moves the space after it"
            app:defaultValue="true" app:iconSpaceReserved="false" />
        <Preference app:key="open_shortcuts" app:title="Text shortcuts"
            app:summary="Type a shortcut like “omw” and tap its expansion in the suggestion bar" app:iconSpaceReserved="false" />
        <Preference app:key="clear_learned" app:title="Forget learned words" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Swipe and gestures" app:iconSpaceReserved="false">
        <ListPreference app:key="gesture_mode" app:title="Keyboard swipe controls" app:defaultValue="fleksy"
            app:entries="@array/gesture_names" app:entryValues="@array/gesture_values"
            app:useSimpleSummaryProvider="true" app:iconSpaceReserved="false" />
        <Preference app:key="gesture_help" app:selectable="false" app:iconSpaceReserved="false"
            app:summary="Fleksy gestures: swipe right = space (twice = full stop), swipe left = delete word, swipe down / up = next / previous suggestion or punctuation." />
        <SwitchPreferenceCompat app:key="space_cursor" app:title="Spacebar cursor control"
            app:summary="Slide along the spacebar to move the cursor" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="delete_swipe" app:title="Swipe left from backspace"
            app:summary="Selects words to delete; release to delete them" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="paw_trail" app:title="Paw-print swipe trail" app:defaultValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="Feedback" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="sound" app:title="Sound" app:defaultValue="false" app:iconSpaceReserved="false" />
        <SwitchPreferenceCompat app:key="vibrate" app:title="Vibration" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference app:key="vibrate_ms" app:title="Vibration strength" app:defaultValue="12"
            app:min="4" android:max="40" app:dependency="vibrate"
            app:iconSpaceReserved="false"/>
        <SwitchPreferenceCompat app:key="key_preview" app:title="Character preview" app:defaultValue="true" app:iconSpaceReserved="false" />
        <SeekBarPreference app:key="long_press_ms" app:title="Long-press delay (ms)" app:defaultValue="300"
            app:min="150" android:max="800" app:showSeekBarValue="true" app:seekBarIncrement="50"
            app:iconSpaceReserved="false"/>
    </PreferenceCategory>

    <PreferenceCategory app:title="Clipboard" app:iconSpaceReserved="false">
        <SwitchPreferenceCompat app:key="clipboard_history" app:title="Clipboard history"
            app:summary="Keep the last 30 things you copied (passwords are never saved)" app:defaultValue="true" app:iconSpaceReserved="false" />
    </PreferenceCategory>

    <PreferenceCategory app:title="About" app:iconSpaceReserved="false">
        <Preference app:key="about" app:title="PawKeys 🐾" app:selectable="false" app:iconSpaceReserved="false"
            app:summary="Word list derived from FrequencyWords by Hermit Dave (CC BY-SA 4.0). Icons: Material Symbols (Apache 2.0)." />
    </PreferenceCategory>
</PreferenceScreen>
